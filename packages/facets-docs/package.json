{
    "name": "@uncharted.software/facets-docs",
    "version": "4.0.5",
    "license": "MIT",
    "type": "module",
    "main": "",
    "scripts": {
        "build": "vite build",
        "preview": "vite preview",
        "clean": "run-p clean:*",
        "clean:code": "rm -rf ./dist",
        "clean:pages": "rm -rf ./pages",
        "pages": "yarn pages:dist && yarn pages:assets",
        "pages:dist": "copyfiles dist/**/* pages",
        "pages:assets": "copyfiles --up 1 public/**/* pages",
        "start": "vite",
        "lint": "eslint .",
        "lint:fix": "yarn lint --fix",
        "prepack": "npm-run-all clean build",
        "bump-to": "yarn version"
    },
    "dependencies": {
        "@codemirror/lang-css": "6.3.1",
        "@codemirror/lang-html": "6.4.9",
        "@codemirror/lang-javascript": "6.2.2",
        "@uncharted.software/facets-core": "workspace:^4.0.5",
        "@uncharted.software/facets-plugins": "workspace:^4.0.5",
        "codemirror": "6.0.1",
        "lit": "3.2.1",
        "nick-generator": "1.0.1"
    },
    "devDependencies": {
        "@eslint/js": "9.19.0",
        "copyfiles": "2.4.1",
        "eslint": "9.19.0",
        "typescript": "5.7.3",
        "typescript-eslint": "8.22.0",
        "vite": "6.0.10"
    }
}
